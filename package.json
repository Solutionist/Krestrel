{
  "name": "krestrel",
  "version": "1.0.0",
  "description": "Self-hosted, real-time NYSE/Nasdaq ticker and portfolio tracker that runs on your own machine (loopback only).",
  "license": "MIT",
  "author": "Solutionist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solutionist/Krestrel.git"
  },
  "homepage": "https://github.com/Solutionist/Krestrel#readme",
  "bugs": {
    "url": "https://github.com/Solutionist/Krestrel/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "HOST=127.0.0.1 PORT=3000 react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "lightweight-charts": "5.2.1",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "30.1.2",
    "pino-pretty": "13.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
