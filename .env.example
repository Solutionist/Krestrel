# Copy to .env and fill in the Alpaca keys:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# --- PostgreSQL (docker compose `db` service) ---
POSTGRES_USER=krestrel
POSTGRES_PASSWORD=krestrel
POSTGRES_DB=krestrel
# Host port for Postgres; always bound to 127.0.0.1.
POSTGRES_PORT=5432

# --- App ---
# Used when the app runs on the host (bun run dev / start). Inside docker compose the
# app service overrides this to reach the `db` service.
DATABASE_URL=postgres://krestrel:krestrel@127.0.0.1:5432/krestrel
# Host port for the containerised app; always bound to 127.0.0.1.
APP_PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Days of 1-minute history to backfill per symbol.
BACKFILL_DAYS=30
# Years of daily history for 1D/1W/2W/1M/1Y charts (Alpaca SIP data starts in 2016).
DAILY_HISTORY_YEARS=10

# --- Market data provider ---
# Which provider streams data: alpaca | mock  (mock = simulated data, no keys needed).
# Each provider validates only its own variables below (ADR 0009).
MARKET_PROVIDER=alpaca

# --- Provider: alpaca (free Basic plan; paper-account keys work for market data) ---
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Free plan: iex only. sip requires a paid subscription.
ALPACA_STREAM_FEED=iex
# Trading API host for clock/assets. Paper keys: paper-api; live keys: https://api.alpaca.markets
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# --- AI features: outlook, stock ideas, screenshot import, holding groups (ADR 0012, 0016–0020) ---
# Each feature uses Claude or a local model, picked in the app's AI menu.
# claude-cli = your own Claude Code CLI and Claude subscription (run `claude` once and /login);
# none = turn every AI feature off. Data goes to Anthropic only for features set to Claude.
LLM_PROVIDER=claude-cli
# CLAUDE_CLI_PATH=claude
# CLAUDE_MODEL=sonnet
# Wait for a Claude call without its own budget (holding groups). The outlook, stock ideas and
# screenshot import always allow 300000 (5 min).
# CLAUDE_TIMEOUT_MS=180000

# Local models run on your own Ollama (ollama.com) and never leave this machine. Not available
# inside the Docker image. Download models from the app's AI menu, or `ollama pull <model>`.
# Presets: qwen3.8:27b (Large, 24 GB GPU) · qwen3-vl:8b-instruct (Medium) · qwen3-vl:4b-instruct (Small).
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3-vl:8b-instruct

# Optional web search for local models (outlook, ideas). Only search queries (a ticker, or a sector
# and year) are sent to Tavily; get a key at tavily.com. Claude searches the web on its own.
# TAVILY_API_KEY=

# --- Provider: mock ---
# Seed for the deterministic simulated history/price walk, and live tick interval (ms).
MOCK_SEED=42
MOCK_TICK_MS=1000
